{
  "name": "mcp-emtrafesa",
  "description": "A Model Context Protocol (MCP) server for accessing Emtrafesa bus transportation services in Peru",
  "version": "2.1.0",
  "module": "src/index.ts",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "type": "module",
  "bin": {
    "mcp-emtrafesa": "dist/src/index.js"
  },
  "private": false,
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "server",
    "emtrafesa",
    "peru",
    "transportation",
    "bus",
    "api",
    "typescript",
    "bun",
    "sdk",
    "cheerio",
    "html",
    "scraping",
    "claude"
  ],
  "author": "George Giosue",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/georgegiosue/mcp-emtrafesa"
  },
  "files": [
    "dist/src/*.js",
    "dist/src/*.d.ts"
  ],
  "scripts": {
    "build": "bun build --target=node ./src/index.ts --outdir=dist/src && bun run build:declaration",
    "build:declaration": "tsc --emitDeclarationOnly --project tsconfig.types.json",
    "format": "bunx biome check --write",
    "prepare": "husky",
    "prepublishOnly": "bun run build",
    "inspect": "bunx @modelcontextprotocol/inspector bun src/index.ts",
    "dev:worker": "NODE_EXTRA_CA_CERTS=certs/sectigo-r46.pem wrangler dev",
    "deploy": "wrangler deploy",
    "inspect:worker": "bunx @modelcontextprotocol/inspector",
    "test": "bun test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/bun": "1.3.14",
    "husky": "9.1.7",
    "wrangler": "4.120.1"
  },
  "peerDependencies": {
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "cheerio": "1.2.0",
    "zod": "4.4.3"
  }
}
